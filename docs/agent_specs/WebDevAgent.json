{
  "name": "WebDevAgent",
  "version": "1.0.0",
  "description": "Creates lightweight web artifacts such as landing pages or promotional HTML snippets and returns a deployable asset.",
  "capabilities": [
    "webpage generation",
    "HTML/CSS templating",
    "basic deployment",
    "asset packaging"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "Details of promotional content or product for which a landing page is needed"
      }
    },
    "required": ["brief"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "artifact": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "html_snippet": { "type": "string" }
        }
      },
      "confidence": { "type": "number" }
    }
  },
  "examples": {
    "input": { "brief": "Landing page for Product X micro-campaign" },
    "output": {
      "artifact": {
        "url": "https://example.local/landing.html",
        "html_snippet": "<h1>Introducing Product X</h1>"
      },
      "confidence": 0.9
    }
  },
  "metadata": {
    "author": "Aegis System",
    "created_at": "2025-11-01",
    "tags": ["webdev", "deployment", "html"]
  }
}
